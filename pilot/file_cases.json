  "scenarios": [
    {
      "id": "PKG-UPDATE-SUBSET",
      "class": "com.jiuyan.banquet.service.PackageService",
      "steps": [
        {
          "op": "observe",
          "subject": "fixture:pkg4",
          "view": "pkg_items",
          "as": "before_items"
        },
        {
          "op": "call",
          "method": "update",
          "args": [
            4,
            {
              "$t": "template",
              "v": "updateReq"
            }
          ],
          "capture": {
            "response_item_count": {
              "path": "items",
              "op": "count"
            }
          }
        },
        {
          "op": "observe",
          "subject": "fixture:pkg4",
          "view": "pkg_items",
          "as": "after_items"
        }
      ],
      "measures": [
        {
          "name": "after_items_count",
          "op": "count",
          "of": "after_items"
        }
      ],
      "checks": [
        {
          "check": "after_items_count",
          "op": "eq",
          "expect": 1,
          "note": "PUT 只提交 1 个商品：PackageService.applyItems 的 removeIf 会把未提交的明细删掉（全量替换语义，PUT 语义下不算缺陷）"
        },
        {
          "check": "result",
          "op": "eq",
          "expect": "ok",
          "note": "更新本身成功"
        }
      ]
    },
    {
      "id": "PKG-UPDATE-MISSING-PRODUCT",
      "class": "com.jiuyan.banquet.service.PackageService",
      "steps": [
        {
          "op": "observe",
          "subject": "fixture:pkg4",
          "view": "pkg_items",
          "as": "before_items"
        },
        {
          "op": "call",
          "method": "update",
          "args": [
            4,
            {
              "$t": "template",
              "v": "updateReqMissingProduct"
            }
          ]
        },
        {
          "op": "observe",
          "subject": "fixture:pkg4",
          "view": "pkg_items",
          "as": "after_items"
        },
        {
          "op": "read",
          "subject": "fixture:pkg4",
          "path": "name",
          "mode": "text",
          "as": "entity_name_after"
        },
        {
          "op": "read",
          "subject": "fixture:pkg4",
          "path": "priceCent",
          "as": "entity_price_after"
        }
      ],
      "measures": [
        {
          "name": "after_items_count",
          "op": "count",
          "of": "after_items"
        }
      ],
      "checks": [
        {
          "check": "error_type",
          "op": "eq",
          "expect": "BusinessException",
          "note": "不存在的商品 id 走 findProduct -> BusinessException(PRODUCT_NOT_FOUND)"
        },
        {
          "check": "http_status",
          "op": "eq",
          "expect": 404,
          "note": "对外是 404 而不是 500"
        },
        {
          "check": "after_items_count",
          "op": "eq",
          "expect": 0,
          "note": "★ 异常抛出时实体明细已被 removeIf 清空：删除发生在存在性校验之前（中间态已改坏）"
        }
      ]
    },

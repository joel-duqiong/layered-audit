    {
      "id": "CORS-ORIGIN-MATRIX",
      "class": "com.jiuyan.banquet.config.WebConfig",
      "steps": [
        {
          "op": "instantiate",
          "class": "org.springframework.web.servlet.config.annotation.CorsRegistry",
          "as": "registry"
        },
        {
          "op": "call",
          "method": "addCorsMappings",
          "args": [
            {
              "$t": "captured",
              "v": "registry"
            }
          ],
          "outcome": false
        },
        {
          "op": "cors_probe",
          "from": "registry",
          "pattern": "/api/**",
          "origins": [
            "http://localhost:5173",
            "http://localhost:9999",
            "http://127.0.0.1:5173",
            "http://192.168.1.5:8080",
            "http://192.168.1.5:9999",
            "http://10.0.0.7:3000",
            "http://172.16.0.9:1234",
            "http://evil.example.com",
            "https://evil.example.com",
            "http://localhost.evil.com",
            "null",
            "http://[::1]:5173"
          ],
          "as": {
            "mapping_keys": "mapping_keys",
            "config_found": "config_found",
            "patterns": "allowed_origin_patterns",
            "probes": "probes"
          }
        }
      ],
      "measures": [
        {
          "name": "evil_allowed",
          "op": "lookup",
          "of": "probes",
          "key": "origin",
          "field": "allowed",
          "value": "http://evil.example.com"
        },
        {
          "name": "https_evil_allowed",
          "op": "lookup",
          "of": "probes",
          "key": "origin",
          "field": "allowed",
          "value": "https://evil.example.com"
        },
        {
          "name": "localhost_any_port_allowed",
          "op": "lookup",
          "of": "probes",
          "key": "origin",
          "field": "allowed",
          "value": "http://localhost:9999"
        },
        {
          "name": "intranet_any_port_allowed",
          "op": "all_lookup",
          "of": "probes",
          "key": "origin",
          "field": "allowed",
          "values": [
            "http://192.168.1.5:9999",
            "http://10.0.0.7:3000"
          ]
        }
      ],
      "checks": [
        {
          "check": "evil_allowed",
          "op": "eq",
          "expect": false,
          "note": "外网站点不得被放行"
        },
        {
          "check": "intranet_any_port_allowed",
          "op": "eq",
          "expect": true,
          "note": "★ 内网任意主机 + 任意端口都被放行（http://192.168.*.*:[*] 之类的通配）"
        },
        {
          "check": "localhost_any_port_allowed",
          "op": "eq",
          "expect": true,
          "note": "本机任意端口放行（开发期合理）"
        },
        {
          "check": "https_evil_allowed",
          "op": "eq",
          "expect": false,

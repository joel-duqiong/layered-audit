          "suffix": "/"
        },
        {
          "name": "missing_dir_to_uri_ends_with_slash",
          "op": "ends_with",
          "of": "missing_dir_to_uri",
          "suffix": "/"
        },
        {
          "name": "relative_with_slash_ok",
          "op": "contains",
          "of": "relative_with_slash",
          "text": "/exists/seed/banquet-table.png"
        },
        {
          "name": "relative_without_slash_ok",

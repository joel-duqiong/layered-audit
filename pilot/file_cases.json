            {
              "name": "missing_dir_to_uri",
              "dir": "missing"
            },
            {
              "name": "relative_with_slash",
              "dir": "exists",
              "relative": "seed/banquet-table.png"
            },
            {
              "name": "relative_without_slash",
              "dir": "missing",
              "relative": "seed/banquet-table.png"
            },
            {
              "name": "webconfig_location_for_existing",
              "dir": "exists"
            },
            {
              "name": "webconfig_location_for_missing",
              "dir": "missing"
            }
          ]
        }
      ],
      "measures": [
        {

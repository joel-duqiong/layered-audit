          "note": "★ 目录不存在时 toUri() 不带尾斜杠 -> Spring 会把 /uploads/x.jpg 拼成 <root>x.jpg，全部 404"
        },
        {
          "check": "relative_without_slash_ok",
          "op": "eq",
          "expect": false,
          "note": "★ 无尾斜杠时相对路径被拼坏"
        },
        {
          "check": "relative_with_slash_ok",
          "op": "eq",
          "expect": true,
          "note": "有尾斜杠时相对路径正确"

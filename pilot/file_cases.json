        },
        {
          "op": "call",
          "class": "com.jiuyan.banquet.config.ApiResponseAdvice",
          "method": "beforeBodyWrite",
          "args": [
            {
              "$t": "staticCall",
              "staticCall": {
                "class": "com.jiuyan.banquet.dto.ApiResponse",
                "method": "error",
                "args": [
                  "X",
                  "msg",
                  null,
                  "t",
                  {
                    "$t": "dt",

{
  "cases": [
    {
      "id": "OB-RESOLVE-PRICE-UPPER-BOUND",
      "group": "SEMANTIC_OBLIGATION",
      "func": "reflect",
      "class": "com.jiuyan.banquet.service.OrderService",
      "method": "resolveFinalPrice",
      "args": [
        {
          "$t": "bool",
          "v": true
        },
        {
          "$t": "long",
          "v": 999999
        },
        {
          "$t": "long",
          "v": 46800
        }
      ],
      "check": {
        "type": "returns_le",
        "value": 46800
      },
      "invariant": "计算订单最终成交价：客户端报的价格高于套餐标价时，必须被拒绝或限到套餐价以内",
      "label": "成交价上界",
      "stubs": {}
    },
    {
      "id": "OB-PARSE-STATUS-INVALID",
      "group": "SEMANTIC_OBLIGATION",
      "func": "reflect",
      "class": "com.jiuyan.banquet.service.OrderService",
      "method": "parseStatus",
      "args": [
        {
          "$t": "str",
          "v": "NOT_A_STATUS"
        }
      ],
      "check": {
        "type": "throws_business",
        "value": {
          "code": "ORDER_STATUS_INVALID",
          "status": 422
        }
      },
      "invariant": "把状态串解析成合法状态：认不出的状态必须以业务错误码拒绝，不能默默当 null",
      "label": "非法状态必须 422",
      "stubs": {}
    },
    {
      "id": "OB-PARSE-DATE-SCOPE-INVALID",
      "group": "SEMANTIC_OBLIGATION",
      "func": "reflect",
      "class": "com.jiuyan.banquet.service.OrderService",
      "method": "parseDateScope",
      "args": [
        {
          "$t": "str",
          "v": "NOT_A_RANGE"
        }
      ],
      "check": {
        "type": "throws_business",
        "value": {
          "code": "VALIDATION_ERROR",
          "status": 400
        }
      },
      "invariant": "解析日期区间：认不出的区间必须 400 拒绝，不能默默不过滤",
      "label": "非法日期区间必须 400",
      "stubs": {}
    },
    {
      "id": "OB-NORMALIZE-ITEMS-DUPLICATE",
      "group": "SEMANTIC_OBLIGATION",
      "func": "reflect",
      "class": "com.jiuyan.banquet.service.OrderService",
      "method": "normalizePackageItems",
      "args": [
        {
          "$t": "pkgItems",
          "v": [
            {
              "productId": 11,
              "quantity": 2
            },
            {
              "productId": 11,
              "quantity": 3
            }
          ]
        }
      ],
      "check": {
        "type": "throws_business",
        "value": {
          "code": "VALIDATION_ERROR",
          "status": 422
        }
      },
      "invariant": "明细归一化：同一个商品出现两次必须拒绝，不能静默合并",
      "label": "明细重复必须拒绝",
      "stubs": {}
    },
    {
      "id": "OB-NORMALIZE-ITEMS-QUANTITY",
      "group": "SEMANTIC_OBLIGATION",
      "func": "reflect",
      "class": "com.jiuyan.banquet.service.OrderService",
      "method": "normalizePackageItems",
      "args": [
        {
          "$t": "pkgItems",
          "v": [
            {
              "productId": 11,
              "quantity": 0
            }
          ]
        }
      ],
      "check": {
        "type": "throws_business",
        "value": {
          "code": "VALIDATION_ERROR",
          "status": 422
        }
      },
      "invariant": "明细归一化：数量必须是正整数，0 或负数必须拒绝",
      "label": "数量必须 ≥1",
      "stubs": {}
    },
    {
      "id": "OB-FIND-PRODUCT-MISSING",
      "group": "SEMANTIC_OBLIGATION",
      "func": "reflect",
      "class": "com.jiuyan.banquet.service.ProductService",
      "method": "findProduct",
      "args": [
        {
          "$t": "long",
          "v": 99999999
        }
      ],
      "check": {
        "type": "throws_business",
        "value": {
          "code": "PRODUCT_NOT_FOUND",
          "status": 404
        }
      },
      "invariant": "按 id 取商品：商品不存在（或已软删）必须报 404，不能返回 null 让调用方自己炸",
      "label": "商品不存在必须 404",
      "stubs": {}
    },
    {
      "id": "OB-FIND-PACKAGE-MISSING",
      "group": "SEMANTIC_OBLIGATION",
      "func": "reflect",
      "class": "com.jiuyan.banquet.service.PackageService",
      "method": "findPackage",
      "args": [
        {
          "$t": "long",
          "v": 99999999
        }
      ],
      "check": {
        "type": "throws_business",
        "value": {
          "code": "PACKAGE_NOT_FOUND",
          "status": 404
        }
      },
      "invariant": "按 id 取套餐：套餐不存在（或已软删）必须报 404",
      "label": "套餐不存在必须 404",
      "stubs": {}
    },
    {
      "id": "OB-CATEGORY-CREATE-IDEMPOTENT",
      "group": "SEMANTIC_OBLIGATION",
      "func": "reflect",
      "class": "com.jiuyan.banquet.service.CategoryService",
      "method": "create",
      "args": [
        {
          "$t": "entity",
          "class": "com.jiuyan.banquet.dto.CreateCategoryRequest",
          "fields": {
            "name": "ai_probe_semantic_cat"
          }
        }
      ],
      "check": {
        "type": "returns_non_null"
      },
      "invariant": "创建分类：同名时返回既有分类（幂等），必须返回分类对象而不是空",
      "label": "创建分类必须返回分类",
      "stubs": {}
    },
    {
      "id": "OB-PRICE-NEGATIVE-MUST-REJECT",
      "group": "SEMANTIC_OBLIGATION",
      "func": "reflect",
      "class": "com.jiuyan.banquet.service.PackageService",
      "method": "applyBase",
      "args": [
        {
          "$t": "entity",
          "class": "com.jiuyan.banquet.entity.BanquetPackage",
          "fields": {
            "id": 4,
            "name": "婚宴双人套餐",
            "banquetType": "婚宴",
            "priceCent": 100000,
            "imageUrl": "https://example.com/pkg.png",
            "description": "双人精选套餐",
            "isActive": true,
            "isDeleted": false,
            "items": []
          }
        },
        {
          "$t": "str",
          "v": "婚宴双人套餐"
        },
        {
          "$t": "str",
          "v": "婚宴"
        },
        {
          "$t": "long",
          "v": -1
        },
        {
          "$t": "str",
          "v": "https://example.com/pkg.png"
        },
        {
          "$t": "str",
          "v": "双人精选套餐"
        },
        {
          "$t": "bool",
          "v": true
        }
      ],
      "check": {
        "type": "throws_business",
        "value": "PRICE_INVALID"
      },
      "invariant": "把套餐基础字段写进 BanquetPackage 时，priceCent 不得小于 0；传入负金额时必须以业务错误 PRICE_INVALID 拒绝，而不是照单全收。",
      "label": "套餐金额为负必须被拒绝，且给出 PRICE_INVALID",
      "stubs": {
        "com.jiuyan.banquet.repository.PackageTypeRepository": {
          "findByNameAndIsDeletedFalse": {
            "$optional": {
              "$t": "entity",
              "class": "com.jiuyan.banquet.entity.PackageType",
              "fields": {
                "id": 13,
                "name": "婚宴",
                "sortOrder": 1,
                "isDeleted": false
              }
            }
          }
        }
      }
    },
    {
      "id": "OB-PACKAGE-ITEMS-EMPTY-MUST-REJECT",
      "group": "SEMANTIC_OBLIGATION",
      "func": "reflect",
      "class": "com.jiuyan.banquet.service.PackageService",
      "method": "applyItems",
      "args": [
        {
          "$t": "entity",
          "class": "com.jiuyan.banquet.entity.BanquetPackage",
          "fields": {
            "id": 4,
            "name": "婚宴双人套餐",
            "banquetType": "婚宴",
            "priceCent": 100000,
            "imageUrl": "https://example.com/pkg.png",
            "description": "双人精选套餐",
            "isActive": true,
            "isDeleted": false,
            "items": []
          }
        },
        {
          "$t": "entity",
          "class": "java.util.ArrayList",
          "fields": {}
        }
      ],
      "check": {
        "type": "throws_business",
        "value": "VALIDATION_ERROR"
      },
      "invariant": "写入套餐商品明细时，商品集合不得为空；传入空集合时必须以业务错误 VALIDATION_ERROR 拒绝，而不是把套餐保存成没有任何商品的空套餐。",
      "label": "套餐商品为空必须被拒绝，且给出 VALIDATION_ERROR",
      "stubs": {}
    },

      "unit": "com.jiuyan.banquet.service.OrderService#normalizePackageItems",
      "class": "com.jiuyan.banquet.service.OrderService",
      "method": "normalizePackageItems",
      "group": "SEMANTIC_OBLIGATION",
      "label": "数量必须 ≥1",
      "mission": "明细归一化：数量必须是正整数，0 或负数必须拒绝",
      "template": "throws_business_code",
      "args": [
        {
          "$t": "pkgItems",
          "v": [
            {
              "productId": 11,
              "quantity": 0
            }
          ]
        }
      ],
      "bound": {
        "kind": "const",
        "value": {
          "code": "VALIDATION_ERROR",
          "status": 422
        }
      },
      "source": "declared",
      "finding": {
        "id": "FN-SEMANTIC-ITEM-QUANTITY-NON-POSITIVE",
        "severity": "MEDIUM",
        "title": "职责断言：明细数量必须是正整数，数量为 0 被原样接受",
        "root_cause": "normalizePackageItems 只检查商品是否重复，不检查数量；quantity=0 会被原样归一化进快照，明细合计因此少算这一项",
        "cwe": null,
        "api_reachable": true,
        "boundary_protected": false,
        "boundary_note": "PackageItemRequest.quantity 上没有 @Min(1)，服务端也没补"
      }
    },

{
  "note": "语义地图（项目侧）：每个单元的「使命」+ 一条可机械验证的断言。编译器把职责编译成可执行 case，复用函数层已有的执行器。source=declared 的是人工确认的；source=model_hint 的模型产出永远 gate_eligible=false（只是线索，不进门禁）。",
  "missions": [
    {
      "id": "OB-RESOLVE-PRICE-UPPER-BOUND",
      "unit": "com.jiuyan.banquet.service.OrderService#resolveFinalPrice",
      "class": "com.jiuyan.banquet.service.OrderService",
      "method": "resolveFinalPrice",
      "group": "SEMANTIC_OBLIGATION",
      "label": "成交价上界",
      "mission": "计算订单最终成交价：客户端报的价格高于套餐标价时，必须被拒绝或限到套餐价以内",
      "template": "returns_le_arg",
      "args": [
        {
          "$t": "bool",
          "v": true
        },
        {
          "$t": "long",
          "v": 999999
        },
        {
          "$t": "long",
          "v": 46800
        }
      ],
      "bound": {
        "kind": "arg",
        "index": 2,
        "limit": 46800
      },
      "source": "declared",
      "finding": {
        "id": "FN-SEMANTIC-PRICE-UPPER-BOUND",
        "severity": "HIGH",
        "title": "职责断言：成交价不得高于套餐标价",
        "root_cause": "resolveFinalPrice 只校验了成交价非负，没有与套餐标价比对，客户端报 999999 分（套餐价 46800 分）被原样接受",
        "cwe": null,
        "api_reachable": true,
        "boundary_protected": false,
        "boundary_note": "DTO 上只有 @Min(0)，没有上界"
      }
    },
    {
      "id": "OB-PARSE-STATUS-INVALID",
      "unit": "com.jiuyan.banquet.service.OrderService#parseStatus",
      "class": "com.jiuyan.banquet.service.OrderService",
      "method": "parseStatus",
      "group": "SEMANTIC_OBLIGATION",
      "label": "非法状态必须 422",
      "mission": "把状态串解析成合法状态：认不出的状态必须以业务错误码拒绝，不能默默当 null",
      "template": "throws_business_code",
      "args": [
        {
          "$t": "str",
          "v": "NOT_A_STATUS"
        }
      ],
      "bound": {
        "kind": "const",
        "value": {
          "code": "ORDER_STATUS_INVALID",
          "status": 422
        }
      },
      "source": "declared"
    },
    {
      "id": "OB-PARSE-DATE-SCOPE-INVALID",
      "unit": "com.jiuyan.banquet.service.OrderService#parseDateScope",
      "class": "com.jiuyan.banquet.service.OrderService",
      "method": "parseDateScope",
      "group": "SEMANTIC_OBLIGATION",
      "label": "非法日期区间必须 400",
      "mission": "解析日期区间：认不出的区间必须 400 拒绝，不能默默不过滤",
      "template": "throws_business_code",
      "args": [

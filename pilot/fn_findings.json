      "id": "FN-PRICE-CLIENT-CONTROLLED",
      "layer": "function",
      "severity": "CRITICAL",
      "title": "成交价由客户端说了算：resolveFinalPrice 只做下界检查，完全不与套餐价比对",
      "function": "OrderService.resolveFinalPrice",
      "root_cause": "resolveFinalPrice(boolean, Long, Long) 只校验成交价 >= 0，既不要求成交价 <= 套餐总价，也不要求有折扣依据，于是客户端可以把任意数字直接变成订单最终价。",
      "api_reachable": true,
      "boundary_protected": false,
      "boundary_note": "CreateOrderRequest.finalPriceCent 只有 @Min(0)，上界没有任何约束",
      "cwe": null,
      "owner": "函数层（OrderService.resolveFinalPrice）",
      "case_count": 4,
      "evidence": [
        {
          "case_id": "APL-15",
          "function": "com.jiuyan.banquet.service.OrderService#apply",
          "invariant": "落库的成交价不得高于套餐总价",
          "actual": "期望 finalPriceCent <= 46800，实际 999999",
          "exception": null
        },
        {
          "case_id": "RFP-05",
          "function": "com.jiuyan.banquet.service.OrderService#resolveFinalPrice",
          "invariant": "成交价不得低于套餐总价（客户端不能自降定价权）",
          "actual": "期望 >= 46800，实际 1",
          "exception": null
        },
        {
          "case_id": "RFP-06",
          "function": "com.jiuyan.banquet.service.OrderService#resolveFinalPrice",
          "invariant": "成交价不得高于套餐总价",
          "actual": "期望 <= 46800，实际 999999",
          "exception": null
        },
        {
          "case_id": "RFP-07",
          "function": "com.jiuyan.banquet.service.OrderService#resolveFinalPrice",
          "invariant": "成交价不得为 0（0 元成交无任何业务依据）",
          "actual": "期望 >= 1，实际 0",
          "exception": null
        }
      ],

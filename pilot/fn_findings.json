    {
      "id": "FN-ORDER-NO-COLLISION",
      "layer": "function",
      "severity": "HIGH",
      "title": "订单号每秒只有 1000 个槽位，并发下单必然撞号（唯一键冲突 → 500）",
      "function": "OrderService.generateOrderNo",
      "root_cause": "订单号格式 DD + yyyyMMddHHmmss + 3 位随机，随机空间只有 1000/秒；existsByOrderNo 检查与 insert 非原子（TOCTOU），并发事务互相看不见，重复号直接撞 uk_orders_order_no 唯一约束。",
      "api_reachable": true,
      "boundary_protected": false,
      "boundary_note": "无任何边界能挡住并发写；客户端请求速率就是下单速率",
      "cwe": "CWE-362",
      "owner": "函数层（OrderService.generateOrderNo）",
      "case_count": 1,
      "evidence": [
        {
          "case_id": "GON-02",
          "function": "com.jiuyan.banquet.service.OrderService#generateOrderNo",
          "invariant": "同一秒内生成的订单号必须互不相同（唯一槽位只有 1000 个/秒）",
          "actual": "并发生成 3000 个订单号，重复 2044 个 | generated=3000 distinct=956 elapsed=0ms",
          "exception": null
        }
      ],
      "related_findings": []
    },

  {
    "id": "CLASS-REQUIRED-CHECKED-IN-SERVICE-LAYER",
    "severity": "MEDIUM",
    "layer": "class",
    "title": "orders.finalPriceCent 必填性校验落在服务层，DTO 少一条 @NotNull",
    "detail": "DB 与实体都声明 NOT NULL，DTO 只写了 @Min(0) 而没有 @NotNull —— 字段在传输层是可空的，靠服务层补一句判断拦住。实测：传 null 返回 422 / PRICE_INVALID，文案是「成交价不能小于 0」。后果一：责任错层，任何绕过服务层的写入方（脚本、数据修复）都会撞 DB 报错；后果二：报错文案说的是「小于 0」，真实原因是「不能为空」，客户端无法据此定位。",
    "evidence": {
      "dto": "CreateOrderRequest",
      "field": "finalPriceCent",
      "column": "final_price_cent",
      "dto_constraints": [
        "Min(0)"
      ],
      "db_not_null": true,
      "http": 422,
      "code": "PRICE_INVALID",
      "message": "成交价不能小于 0"
    }
  },

    "id": "NO_STATE_MACHINE",
    "severity": "HIGH",
    "layer": "class",
    "title": "状态机缺失：9/9 种迁移全部被接受，含回退",
    "detail": "DDL 只有取值白名单 CHECK (status IN (...))，没有任何迁移约束；实测 9 种迁移全部 200 成功。业务后果：已付款（DEPOSIT_PAID）/已完成（COMPLETED）的订单可以被改回 PENDING，押金与结算状态和现实不符，而且没有留下任何迁移记录。",
    "evidence": {
      "allowed": [
        "PENDING->PENDING",
        "PENDING->DEPOSIT_PAID",
        "PENDING->COMPLETED",
        "DEPOSIT_PAID->PENDING",
        "DEPOSIT_PAID->DEPOSIT_PAID",
        "DEPOSIT_PAID->COMPLETED",
        "COMPLETED->PENDING",
        "COMPLETED->DEPOSIT_PAID",
        "COMPLETED->COMPLETED"
      ],
      "backward_transitions": [
        "PENDING->DEPOSIT_PAID",
        "PENDING->COMPLETED",
        "DEPOSIT_PAID->COMPLETED"
      ],
      "ddl_check": "status IN ('PENDING','DEPOSIT_PAID','COMPLETED')"
    }

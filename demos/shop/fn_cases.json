  "cases": [
    {
      "id": "DSP-01",
      "group": "PRICING",
      "func": "reflect",
      "class": "com.demo.shop.service.PricingService",
      "method": "settle",
      "args": [
        {
          "$t": "fixture",
          "v": "1"
        },
        {
          "$t": "long",
          "v": 900000
        }
      ],
      "check": {
        "type": "returns_eq",
        "value": 900000
      },
      "invariant": "标准价策略下按原价结算（MemberPricingStrategy 在非 vip profile 下不激活）",
      "label": ""
    },
    {
      "id": "DSP-02",
      "group": "PRICING",
      "func": "reflect",
      "class": "com.demo.shop.service.PricingService",

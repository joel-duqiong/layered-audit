              "level": "VIP"
            }
          },
          "expected_symptom": "BI-VIP-MEMBER-PRICE",
          "alive_check": {
            "kind": "scenario",
            "cmd": "python3 demos/shop/emergence_probe.py --alive-check INJ-TIER-VIP",
            "scenario": {
              "instance": "default",
              "customer_level": "VIP",
              "quote": 900000,
              "currency": "CNY",
              "probe_invariant": "BI-VIP-MEMBER-PRICE",
              "expect": "violated"
            },
            "why": "单独注入「客户等级=VIP」后，在标准装配下 VIP 客户拿不到会员价（BI-VIP-MEMBER-PRICE 被违反）—— 这一条低层症状可单独复现，说明等级条件确实到达了定价层，且「会员价被绑在部署维度」这个缺陷是活的。若哪天等级维度被修好（VIP 客户到处都拿九折），本条注入即失效，会被活性检查剔除并告警。"
          },
          "active": true
        },
        {
          "id": "INJ-PROFILE-VIP",
          "defect": "order.quota_checked_on_quoted_amount_ledger_on_settled",
          "layer": "service",
          "target_step": "POST /api/orders",
          "mutation": {
            "kind": "instance",
            "instance": "vip"
          },
          "expected_symptom": "BI-VIP-MEMBER-PRICE",
          "alive_check": {
            "kind": "scenario",
            "cmd": "python3 demos/shop/emergence_probe.py --alive-check INJ-PROFILE-VIP",
            "scenario": {
              "instance": "vip",
              "customer_level": "VIP",
              "quote": 900000,
              "currency": "CNY",
              "probe_invariant": "BI-VIP-MEMBER-PRICE",
              "expect": "satisfied"

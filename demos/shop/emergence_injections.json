        "line": 58,
        "symbol": "OrderService.create",
        "endpoint": "POST /api/orders",
        "line_hint": "quotaService.withinLimit(按报价 900000) vs ledgerService.record(按实付 810000)"
      },
      "baseline_instance": "default",
      "flow": {
